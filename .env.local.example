# Toast POS API Configuration
# Get these values from Toast Developer Portal: https://pos.toasttab.com/login

# Your Toast Client ID
VITE_TOAST_CLIENT_ID=your_toast_client_id_here

# Your Toast Client Secret (API Key)
VITE_TOAST_API_KEY=your_toast_client_secret_here

# Your Restaurant GUID (found in Toast Portal)
VITE_TOAST_RESTAURANT_GUID=your_restaurant_guid_here

# Your Management Group GUID (optional, not used for authentication)
VITE_TOAST_MANAGEMENT_GROUP_GUID=your_management_group_guid_here

# Gemini API Key (for AI features)
API_KEY=your_gemini_api_key_here

# Optional: email Daniel when staff submit a manager (UP) review
# Skip send (return { ok: true, emailed: false }) if either is unset.
# RESEND_API_KEY=
# OWNER_NOTIFY_EMAIL=
# OWNER_NOTIFY_FROM=

# Logbook export (GET /api/logbook-export). Required on Vercel or the route
# returns 500 {"error":"server not configured"}. Same value the manager-pack
# box stores as BREWSHIFT_EXPORT_TOKEN. Generate: openssl rand -base64 32
# LOGBOOK_EXPORT_TOKEN=
# Optional override. Defaults to org-boundaries.
# LOGBOOK_EXPORT_ORG_ID=org-boundaries
